{
	"schemaVersion": 1,
	"id": "areaautominer",
	"version": "${version}",
	"name": "AreaAutoMiner",
	"description": "木剑左键选取点1，右键选取点2，按K自动从上往下挖掘范围内方块",
	"authors": [
		"heng_ke"
	],
	"contact": {
		"homepage": "https://github.com/heng-ke/AreaAutoMiner",
		"sources": "https://github.com/heng-ke/AreaAutoMiner"
	},
	"license": "MIT License",
	"icon": "assets/areaautominer/icon.png",
	"environment": "*",
	"accessWidener": "areaautominer.accesswidener",
	"entrypoints": {
		"main": [
			"xyz.hengke.areaautominer.AreaAutoMiner"
		],
		"fabric-datagen": [
			"xyz.hengke.areaautominer.AreaAutoMinerDataGenerator"
		],
		"client": [
			"xyz.hengke.areaautominer.AreaAutoMinerClient"
		]
	},
	"mixins": [
		"areaautominer.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
