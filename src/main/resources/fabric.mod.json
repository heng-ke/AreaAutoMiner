{
	"schemaVersion": 1,
	"id": "areaautominer",
	"version": "${version}",
	"name": "AreaAutoMiner",
	"description": "手持剑右键选取点1，潜行+右键选取点2，按K自动挖掘范围内方块（默认从上往下，可配置）",
	"authors": [
		"heng_ke"
	],
	"contact": {
		"homepage": "https://github.com/heng-ke/AreaAutoMiner",
		"sources": "https://github.com/heng-ke/AreaAutoMiner"
	},
	"license": "MIT License",
	"icon": "assets/areaautominer/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"xyz.hengke.areaautominer.AreaAutoMiner"
		],
		"client": [
			"xyz.hengke.areaautominer.AreaAutoMinerClient"
		],
		"modmenu": [
			"xyz.hengke.areaautominer.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"areaautominer.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": ">=21.11.153"
	},
	"suggests": {
		"modmenu": ">=12.0.0"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.github": "https://github.com/heng-ke/AreaAutoMiner"
			},
			"clientOnly": true
		}
	}
}